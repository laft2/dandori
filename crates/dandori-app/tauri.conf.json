{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dandori",
  "version": "0.2.0",
  "identifier": "app.dandori.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix .. run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix .. run build",
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Dandori",
        "width": 920,
        "height": 680,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdBQTlBNDU5QjhBRjI0ODkKUldTSkpLKzRXYVNwZWpEUjZRVGQxQWwyeE5ncnJuMXRGaUdlTjUzT1drSllLTFZiQmZsNTJaWW4K",
      "endpoints": [
        "https://github.com/laft2/dandori/releases/latest/download/latest.json"
      ]
    }
  }
}
